# 统一换行符处理：仓库内用 LF，避免跨平台 CRLF 噪音
* text=auto

# 明确的文本文件强制 LF
*.py  text eol=lf
*.cs  text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.svg text eol=lf

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做处理
*.exe binary
*.dll binary
*.png binary
*.jpg binary
*.ico binary
